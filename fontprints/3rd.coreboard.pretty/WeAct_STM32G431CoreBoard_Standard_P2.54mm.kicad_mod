(footprint "WeAct_STM32G431CoreBoard_Standard_P2.54mm" (version 20241229) (generator "pcbnew") (layer "F.Cu")
(descr "WeAct STM32G431 standard V1.0 board, QFN48/QFP48 common 36.28x28.14mm board outline, R2.5 USB-side corners and 0.9442mm far-side bevels derived from official PDF vectors; two 2x12 P2.54 sockets on carrier top. Origin P2-1; USB left in top view. P3 SWD is not a carrier mating connector. No Edge.Cuts.")
(tags "WeAct STM32G431 CBU6 CBT6 standard module socket")
